{
  "title": "Fuel Supply Intelligence Platform",
  "uid": "fuel-supply",
  "panels": [
    {
      "title": "Backend Request Rate",
      "type": "graph",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(http_requests_total[1m])",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "Simulator Health",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job='fuel-simulator'}",
          "legendFormat": "simulator"
        }
      ]
    },
    {
      "title": "Active Alerts",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "fuel_active_alerts_total",
          "legendFormat": "alerts"
        }
      ]
    },
    {
      "title": "Circuit Breaker State",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "fuel_circuit_breaker_state",
          "legendFormat": "state"
        }
      ]
    },
    {
      "title": "Decisions Submitted",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "fuel_decisions_total",
          "legendFormat": "decisions"
        }
      ]
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "15s"
}